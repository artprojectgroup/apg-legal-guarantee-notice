msgstr "%1$s años de %2$s, etiqueta GARAN de la UE"

#: includes/clases/garan-tienda.php:215 includes/clases/garan-tienda.php:357
msgid "Commercial guarantee of durability offered by the producer"
msgstr "Garantía comercial de durabilidad ofrecida por el productor"

