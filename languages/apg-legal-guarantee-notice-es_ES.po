msgstr ""
"Aviso de la garantía legal de la UE mostrado en Finalizar compra, en %1$s: "
"%2$s."

#: includes/clases/registro.php:77
msgid "the whole notice, on the page"
msgstr "el aviso completo, en la página"

#: includes/clases/registro.php:78
msgid "a sentence that opens it on the first click"
msgstr "una frase que lo abre al primer clic"

#. translators: %s: reason, e.g. "the order has no goods".
